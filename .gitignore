# === 编译产物（放在工程内，不污染源码树） ===
bin/

# === 本地运行数据与日志 ===
*.db
*.db-wal
*.db-shm
server.log
server.err.log

# === 临时/同步目录 ===
.tmp_sync/

# === 本地工具状态与历史草稿（不上云） ===
.workbuddy/
_backup/

# === 凭证兜底：即使误放进项目也不上云 ===
*.token
*.pat
*.key
*.pem
.env
.env.*
!.env.example
secrets/

# === 验证脚本运行产物（脚本本身入库，产物不入库） ===
.vl_*.db
.vl_*.db-wal
.vl_*.db-shm
.vl_*.proc.log
.verify_result.txt
.test_out.txt
.client_build.log

# 本地打包产物
dist/
